{
  "name": "cs2nades",
  "version": "0.1.18",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng.js",
    "start": "node ./node_modules/@angular/cli/bin/ng.js serve --host 127.0.0.1",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "node ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "node ./node_modules/@angular/cli/bin/ng.js test",
    "smoke:ui": "node ./node_modules/@angular/cli/bin/ng.js test --watch=false --include src/app/app.smoke.spec.ts",
    "extract:cs2-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extract-cs2-assets.ps1",
    "tauri": "tauri",
    "desktop:dev": "node ./scripts/run-tauri-dev.mjs",
    "desktop:build": "node ./scripts/run-tauri-build.mjs",
    "auto:build": "node ./scripts/auto-build.mjs",
    "version:bump-dev": "node ./scripts/bump-dev-version.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@tauri-apps/cli": "^2.11.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
